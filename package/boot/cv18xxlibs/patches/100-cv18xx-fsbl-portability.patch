diff --git a/fsbl/lib/cpu/riscv/cpu_helper.c b/fsbl/lib/cpu/riscv/cpu_helper.c
index 7e093fa0b..585ae2248 100644
--- a/fsbl/lib/cpu/riscv/cpu_helper.c
+++ b/fsbl/lib/cpu/riscv/cpu_helper.c
@@ -11,8 +11,8 @@
 void sync_cache(void)
 {
