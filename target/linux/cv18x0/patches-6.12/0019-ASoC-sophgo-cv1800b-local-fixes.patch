@@ -536,6 +536,15 @@ static int cv1800b_i2s_dai_set_sysclk(struct snd_soc_dai *dai, int clk_id,
 	bool output_enable = (dir == SND_SOC_CLOCK_OUT) ? true : false;
 
 	dev_dbg(i2s->dev, "%s called with %u\n", __func__, freq);
+
+	/*
+	 * Machine drivers (e.g. simple-audio-card with mclk-fs) call
+	 * set_sysclk with freq == 0 on shutdown to release the clock.
+	 * Nothing to program in that case; just accept it.
+	 */
+	if (freq == 0)
+		return 0;
+
 	ret = cv1800b_i2s_set_rate_for_mclk(i2s, freq);
 	if (ret)
 		return ret;
